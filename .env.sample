OPENAI_API_KEY=
SECRET_KEY=

# Optional: enables the GitHub MCP tools in the /agent chatbot. Leave blank to
# run the agent without GitHub lookups (everything else still works).
GITHUB_PERSONAL_ACCESS_TOKEN=
# "hosted" (default) uses GitHub's remote MCP server at api.githubcopilot.com,
# which may require a GitHub Copilot plan on the account to authenticate.
# Set to "self_hosted" to instead run the github-mcp-server binary locally over
# stdio (requires installing it into the Docker image, see Dockerfile).
GITHUB_MCP_MODE=hosted
